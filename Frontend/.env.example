# Backend API URL (no trailing slash).
#
# Local development:
#   VITE_API_URL=http://localhost:3000
#
# Production on Vercel:
#   Leave VITE_API_URL unset (or set to "same").
#   Auth and short API calls use same-origin /api/* (vercel.json → Render).
#   Long AI calls (interview generate, practice, PDFs) hit Render directly
#   so Vercel's 120s rewrite timeout / trailing-slash SPA fallback cannot
#   drop the request. Override with VITE_API_DIRECT_URL if the Render host changes.
#
# Only set a full Render URL if you are NOT using the Vercel API proxy:
#   VITE_API_URL=https://hirepilotai-whej.onrender.com
#   VITE_API_DIRECT_URL=https://hirepilotai-whej.onrender.com
VITE_API_URL=http://localhost:3000
